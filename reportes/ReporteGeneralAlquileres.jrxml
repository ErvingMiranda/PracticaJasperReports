		<property name="com.jaspersoft.studio.field.tree.path" value="rentas"/>
	</field>
	<field name="precio_mensual_acordado" class="java.math.BigDecimal">
		<property name="com.jaspersoft.studio.field.name" value="precio_mensual_acordado"/>
		<property name="com.jaspersoft.studio.field.label" value="precio_mensual_acordado"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="rentas"/>
	</field>
	<variable name="SumaMensualidades" calculation="Sum" class="java.math.BigDecimal">
